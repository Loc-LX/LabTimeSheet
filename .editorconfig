root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true

[*.java]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 4

[*.jsp]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false